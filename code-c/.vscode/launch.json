{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试当前文件（F5）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/运行/c/${fileBasenameNoExtension}-exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "调试编译当前文件"
        }
    ]
}
