{
    // ============================================================
    //  这个文件夹的 VSCode 配置
    //  目的：让编译产物只出现在 运行/c/，绝不在源码目录里生成杂物
    // ============================================================
    "settings": {
        // 关掉 C/C++ 扩展自带的「构建和调试活动文件」快捷方式。
        // 它会把可执行文件生成到源码旁边（Linux 上就是没有后缀的同名文件），
        // 既污染源码目录，又会让 build.sh 误把它当成源码。
        // 本文件夹请一律用 F5（走 .vscode/launch.json）来调试。
        "C_Cpp.debugShortcut": false,

        // 终端里显示 UTF-8 中文，避免源码注释/程序输出乱码
        "terminal.integrated.defaultProfile.linux": "bash"
    }
}
